{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "ALIGNN: Finetune (main.py)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "args": [
                "--cfg",
                "configs/finetune/alignn/alignn_prop.yaml",
                "--devices",
                "1"
            ]
        },
        {
            "name": "ALIGNN: CHGGraph Compare (main.py)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "args": [
                "--cfg",
                "configs/finetune/alignn/alignn_prop.yaml",
                "--devices",
                "1"
            ]
        },
        {
            "name": "CHGNet: Finetune (main.py)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "args": [
                "--cfg",
                "configs/finetune/chgnet/chgnet.yaml",
                "--devices",
                "1"
            ]
        },
        {
            "name": "CHGNet: Pretrain (main.py)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "args": [
                "--cfg",
                "configs/pretrain/pretrained_chgnet.yaml",
                "--pretrain",
                "--devices",
                "1"
            ]
        },
        {
            "name": "Python Debugger: Current File with Arguments",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": "${command:pickArgs}"
        }
    ]
}
